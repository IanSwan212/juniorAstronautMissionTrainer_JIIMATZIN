# Copiar a .env (no se versiona). Credenciales SOLO para desarrollo local.

# --- API ---
NODE_ENV=development
PORT=3000
# Orígenes del frontend permitidos (coma). Vacío = solo mismo origen / proxy de Vite.
CORS_ORIGINS=http://localhost:5173
DB_POOL_MAX=10
# Producción: en el panel del hosting, NO en un archivo. Ver docs/06-produccion.md
# NODE_ENV=production  CORS_ORIGINS=https://<front>  DATABASE_SSL=require  TRUST_PROXY=1
TRUST_PROXY=0
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_S=60
CACHE_SECONDS=60
DATABASE_SSL=disable

# --- DONKI en vivo (endpoint oficial NASA CCMC, sin clave). Valores por defecto ---
# DONKI_BASE_URL=https://ccmc.gsfc.nasa.gov/DONKI-API
# DONKI_CACHE_SECONDS=300
# DONKI_TIMEOUT_MS=10000
# DONKI_MAX_DAYS=30

# --- PostgreSQL (docker compose y API) ---
POSTGRES_USER=jiimatzin
POSTGRES_PASSWORD=jiimatzin_dev
POSTGRES_DB=jiimatzin
POSTGRES_PORT=5433
# Debe coincidir con los valores de arriba (--env-file no expande variables).
DATABASE_URL=postgresql://jiimatzin:jiimatzin_dev@localhost:5433/jiimatzin

# --- Importador ---
# Ruta histórica de lotes exploratorios. El importador actual recibe --archivo y --sha256.
DATA_DIR=../../muestras
# Python 3 para verificar el ZIP sin ejecutar su contenido (por defecto: python).
# PYTHON=C:/ruta/a/python.exe
