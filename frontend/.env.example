# Copiar a .env.local (no se versiona).
# Con el proxy de Vite (vite.config.example.js) no hace falta tocarla: se usa /api/v1 en el mismo origen.
# En producción (front en GitHub Pages, API en otro host), poner la URL pública de la API:
# VITE_API_URL=https://api.ejemplo.org/api/v1
VITE_API_URL=/api/v1
